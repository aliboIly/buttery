{
  "name": "@buttery/core",
  "version": "0.0.0",
  "private": true,
  "description": "Tokens, recipes, primitives, layers and motion presets for buttery.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "@buttery/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./palettes": {
      "@buttery/source": "./src/palettes/index.ts",
      "types": "./dist/palettes.d.ts",
      "default": "./dist/palettes.js"
    },
    "./layout": {
      "@buttery/source": "./src/layout/index.ts",
      "types": "./dist/layout.d.ts",
      "default": "./dist/layout.js"
    },
    "./styles.css": {
      "@buttery/source": "./src/styles/index.css",
      "default": "./dist/styles.css"
    },
    "./tailwind.css": {
      "@buttery/source": "./src/styles/tailwind.css",
      "default": "./dist/tailwind.css"
    },
    "./tokens.json": {
      "@buttery/source": "./src/tokens/tokens.json",
      "default": "./dist/tokens.json"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node scripts/build-css.ts",
    "tokens": "node scripts/generate-tokens.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "catalog:",
    "radix-ui": "catalog:"
  },
  "devDependencies": {
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "^4.3.3",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
