{
  "name": "@butteryui/core",
  "version": "0.11.0",
  "description": "Tokens, recipes, primitives, layers and motion presets for buttery.",
  "license": "MIT",
  "keywords": [
    "design-system",
    "design-tokens",
    "react",
    "motion",
    "layout"
  ],
  "homepage": "https://aliboily.github.io/buttery/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aliboIly/buttery.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/aliboIly/buttery/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "@butteryui/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./palettes": {
      "@butteryui/source": "./src/palettes/index.ts",
      "types": "./dist/palettes.d.ts",
      "default": "./dist/palettes.js"
    },
    "./layout": {
      "@butteryui/source": "./src/layout/index.ts",
      "types": "./dist/layout.d.ts",
      "default": "./dist/layout.js"
    },
    "./styles.css": {
      "@butteryui/source": "./src/styles/index.css",
      "default": "./dist/styles.css"
    },
    "./tailwind.css": {
      "@butteryui/source": "./src/styles/tailwind.css",
      "default": "./dist/tailwind.css"
    },
    "./tokens.json": {
      "@butteryui/source": "./src/tokens/tokens.json",
      "default": "./dist/tokens.json"
    },
    "./llms.txt": "./dist/llms.txt",
    "./llms-full.txt": "./dist/llms-full.txt",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node scripts/build-css.ts && node scripts/build-docs.ts",
    "tokens": "node scripts/generate-tokens.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "catalog:",
    "motion": "catalog:",
    "radix-ui": "catalog:"
  },
  "devDependencies": {
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "^4.3.3",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
