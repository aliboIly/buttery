{
  "name": "@butteryui/lint",
  "version": "1.0.0",
  "description": "ESLint and stylelint configs that enforce buttery's tokens and layout rules.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "eslint",
    "stylelint",
    "design-tokens",
    "design-system"
  ],
  "homepage": "https://aliboily.github.io/buttery/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aliboIly/buttery.git",
    "directory": "packages/lint"
  },
  "bugs": {
    "url": "https://github.com/aliboIly/buttery/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./stylelint": {
      "@butteryui/source": "./src/stylelint/index.ts",
      "types": "./dist/stylelint.d.ts",
      "default": "./dist/stylelint.js"
    },
    "./eslint": {
      "@butteryui/source": "./src/eslint/index.ts",
      "types": "./dist/eslint.d.ts",
      "default": "./dist/eslint.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "stylelint": "^17.16.0",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "eslint": ">=9",
    "stylelint": ">=16"
  },
  "publishConfig": {
    "access": "public"
  }
}
