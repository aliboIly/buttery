{
  "name": "@butteryui/react",
  "version": "0.9.0",
  "description": "buttery's React components and patterns.",
  "license": "MIT",
  "keywords": [
    "react",
    "components",
    "design-system",
    "ui"
  ],
  "homepage": "https://aliboily.github.io/buttery/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aliboIly/buttery.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/aliboIly/buttery/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "@butteryui/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "@butteryui/source": "./src/styles.css",
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node scripts/build-css.ts"
  },
  "devDependencies": {
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:"
  },
  "dependencies": {
    "@butteryui/core": "workspace:*",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "radix-ui": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
