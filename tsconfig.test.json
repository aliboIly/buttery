{
  "extends": "./tooling/tsconfig/base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": "./.tsbuild/test",
    "tsBuildInfoFile": "./.tsbuild/test/tsconfig.tsbuildinfo",
    "types": ["node", "vite/client"]
  },
  "include": ["packages/*/src/**/*.test.ts", "packages/*/src/**/*.test.tsx"],
  "references": [
    {
      "path": "./packages/core"
    },
    {
      "path": "./packages/react"
    },
    {
      "path": "./packages/lint"
    },
    {
      "path": "./packages/test"
    },
    {
      "path": "./packages/mcp"
    },
    {
      "path": "./packages/cli"
    },
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
