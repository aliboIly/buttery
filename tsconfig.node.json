{
  "extends": "./tooling/tsconfig/base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": "./.tsbuild/node",
    "tsBuildInfoFile": "./.tsbuild/node/tsconfig.tsbuildinfo",
    "types": ["node"]
  },
  "include": [
    "*.config.ts",
    "packages/*/*.config.ts",
    "packages/*/scripts/**/*.ts",
    "apps/*/*.config.ts",
    "apps/*/vite/**/*.ts",
    "apps/*/package.json",
    "apps/*/e2e/**/*.ts",
    "apps/templates/*/*.config.ts",
    "apps/templates/*/package.json",
    "apps/templates/*/e2e/**/*.ts",
    "apps/demos/*/*.config.ts",
    "apps/demos/*/package.json",
    "apps/demos/*/e2e/**/*.ts",
    "packages/*/e2e/**/*.ts",
    "apps/docs/src/routes.ts",
    "apps/docs/src/slug.ts",
    "apps/docs/src/release-id.ts",
    "apps/docs/src/demo-sentence.ts",
    "apps/docs/src/search/search.ts",
    "apps/docs/src/search/synonyms.ts",
    "apps/docs/src/foundations/color-groups.ts",
    "apps/docs/src/motion-text.ts",
    "apps/docs/tests/**/*.ts"
  ],
  "references": [
    {
      "path": "./packages/core"
    },
    {
      "path": "./packages/test"
    }
  ]
}
