{
  "extends": "./tooling/tsconfig/base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": "./.tsbuild/node",
    "tsBuildInfoFile": "./.tsbuild/node/tsconfig.tsbuildinfo",
    "types": ["node"]
  },
  "include": [
    "*.config.ts",
    "packages/*/*.config.ts",
    "packages/*/scripts/**/*.ts",
    "apps/*/*.config.ts",
    "apps/*/package.json",
    "apps/*/e2e/**/*.ts",
    "packages/*/e2e/**/*.ts",
    "apps/playground/src/routes.ts"
  ],
  "references": [
    {
      "path": "./packages/core"
    },
    {
      "path": "./packages/test"
    }
  ]
}
