{
  "name": "buttery-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter docs dev",
    "build": "pnpm -r build",
    "tokens": "pnpm --filter @buttery/core tokens",
    "typecheck": "node node_modules/typescript-native/bin/tsc -b",
    "lint": "eslint . --max-warnings=0",
    "lint:css": "stylelint \"**/*.css\" --max-warnings=0 --allow-empty-input",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "node --conditions=@buttery/source node_modules/@playwright/test/cli.js test",
    "test:e2e:rest": "node scripts/e2e.mjs rest",
    "test:e2e:timing": "node scripts/e2e.mjs timing",
    "test:layout": "node scripts/test-layout.mjs",
    "check:private": "node scripts/check-private-paths.mjs",
    "check:tells": "node scripts/check-ai-tells.mjs",
    "check:docs": "node scripts/docs-check.mjs",
    "check:examples": "node scripts/examples-build.mjs",
    "check": "pnpm check:private && pnpm check:tells && pnpm typecheck && pnpm lint && pnpm lint:css && pnpm format:check && pnpm test && pnpm test:e2e:rest && pnpm test:e2e:timing",
    "new-app": "node scripts/new-app.mjs",
    "new-component": "node scripts/new-component.mjs",
    "brand:assets": "node scripts/brand-assets.mjs",
    "changeset": "changeset",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "react": "catalog:",
    "react-dom": "catalog:",
    "stylelint": "^17.16.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.1",
    "typescript-native": "npm:typescript@7.0.2",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
